# ECE AI Studio Environment Configuration
PROJECT_NAME="ECE AI Studio"
ENVIRONMENT="development"
DEBUG=true

# API & Security
SECRET_KEY="supersecret_jwt_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL / SQLite fallback for lightweight standalone dev)
DATABASE_URL="sqlite+aiosqlite:///./ece_studio.db"
# Production Database URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ece_ai_studio"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Storage
STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="ece-artifacts"

# AI Provider API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_DEFAULT_PROVIDER="gemini" # "openai" or "gemini"

# GNU Octave Binary Path (Auto-detected if in PATH)
OCTAVE_EXECUTABLE="octave-cli"

# Quota Limits
FREE_EXECUTION_QUOTA=100
FREE_AI_TOKEN_QUOTA=50000
